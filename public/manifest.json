{
  "manifest_version": 3,
  "name": "OpenDoc Studio",
  "short_name": "OpenDoc Studio",
  "version": "0.1.0",
  "description": "Editor, konverter, dan pengaman dokumen (PDF/Word/Excel/PowerPoint/SPSS/Archive) yang berjalan 100% di browser Anda. Tidak ada file yang diunggah ke server manapun.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Buka OpenDoc Studio"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["downloads", "storage", "alarms", "unlimitedStorage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self'"
  }
}
